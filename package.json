{
  "name": "wellipay-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "WelliPay integration service — server-to-server contract between provider backends and the Patient MobileApp. See docs/mobile-app-integration.md in wellipaypro for the trust rules this implements.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:seed": "tsx prisma/seed.ts",
    "staff:set-password": "node dist/scripts/setStaffPassword.js",
    "provider:list": "node dist/scripts/providerApplications.js list",
    "provider:approve": "node dist/scripts/providerApplications.js approve",
    "provider:reject": "node dist/scripts/providerApplications.js reject",
    "integration:list": "node dist/scripts/recordIntegrations.js list",
    "provider:set-plan": "node dist/scripts/providerPlan.js",
    "integration:register": "node dist/scripts/recordIntegrations.js register",
    "integration:disable": "node dist/scripts/recordIntegrations.js disable",
    "recovery:list": "node dist/scripts/refundRecoveries.js list",
    "recovery:settle": "node dist/scripts/refundRecoveries.js settle",
    "recovery:waive": "node dist/scripts/refundRecoveries.js waive",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@clerk/backend": "^3.21.1",
    "@fastify/cors": "^10.0.1",
    "@fastify/formbody": "^8.0.2",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/sensible": "^6.0.1",
    "@prisma/client": "^6.1.0",
    "argon2": "^0.41.1",
    "fastify": "^5.1.0",
    "fastify-plugin": "^5.0.1",
    "jose": "^5.9.6",
    "pino-pretty": "^13.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "prisma": "^6.1.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^5.0.3"
  }
}
