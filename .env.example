# Copy to .env for local development. On Render, set these as Environment
# Variables on the wellipay-api service instead — DATABASE_URL should be
# the Internal Connection String from the wellipaypro-db Postgres instance.

NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# wellipaypro-db (Render Postgres 18) connection string.
# Local dev: postgresql://postgres:postgres@localhost:5432/wellipay?schema=public
DATABASE_URL=

# Signing secret for the interim client-credentials token issuer
# (src/lib/tokens.ts). Generate with: openssl rand -base64 48
TOKEN_SIGNING_SECRET=
TOKEN_ISSUER=https://api.wellipay.internal
TOKEN_AUDIENCE=wellipay-integration-service

WEBHOOK_MAX_ATTEMPTS=8

# Optional: fixed seed credentials (see prisma/seed.ts). Leave unset to
# get a random client_secret printed once at seed time.
SEED_TENANT_NAME=ABC Healthcare
SEED_CLIENT_ID=client_abc_healthcare
SEED_CLIENT_SECRET=
