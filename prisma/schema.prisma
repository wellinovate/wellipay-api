// WelliPay integration service — schema for the contract in
// wellipaypro/docs/mobile-app-integration.md + .openapi.json
//
// Design notes:
// - All money is integer minor units (kobo for NGN). Never a float column.
// - Every externally-supplied reference (patientRef, facilityRef, sponsorRef,
//   payerRef) is treated as opaque. No names, phone numbers, or clinical data
//   are stored here — see the "Trust and data rules" section of the contract.
// - tenantId is resolved server-side from the authenticated credential on
//   every request; it is never read from the request body.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// One row per organization issued API credentials — a provider backend,
// or (later) another integration consumer. Matches "tenant" throughout
// the contract docs.
enum ProviderType {
  HOSPITAL
  DIAGNOSTIC_LAB
  PHARMACY
  INDEPENDENT_PRACTITIONER
}

enum ProviderApplicationStatus {
  PENDING
  APPROVED
  REJECTED
}

model Tenant {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())
  providerType ProviderType? // null on tenants created before provider types existed; treated as HOSPITAL
  // Paystack subaccount: when set, this provider's online payments settle to
  // its own bank account instead of the platform account.
  paystackSubaccountCode  String?
  settlementBankCode      String?
  settlementAccountNumber String?
  settlementAccountName   String?

  credentials      ApiCredential[]
  invoices         Invoice[]
  fundingRequests  FamilyFundingRequest[]
  eligibilityChecks EligibilityCheck[]
  consents         FinancialConsent[]
  payments         Payment[]
  claims           Claim[]
  webhookEndpoints WebhookEndpoint[]
  outboxEvents     OutboxEvent[]
  idempotencyKeys  IdempotencyRecord[]
  refunds          Refund[]
  unmatchedTransactions UnmatchedTransaction[]
  staff            Staff[]
  paymentPlans     PaymentPlan[]
  settlements      Settlement[]
  financingRecords FinancingRecord[]
  partners         Partner[]
  referrals        Referral[]
  patientAccounts  PatientAccount[]
  patientRecords   PatientRecord[]
  serviceItems     ServiceItem[]
  checkupPackages  CheckupPackage[]
  invoiceLines     InvoiceLine[]
  bookingResults   BookingResult[]
  bookings         Booking[]
  corporateAccounts CorporateAccount[]
  hmoPolicies      HmoPolicy[]
  preAuthorizations PreAuthorization[]

  @@map("tenants")
}

// OAuth2 client-credentials client. clientSecretHash is argon2/bcrypt, never
// plaintext. This is a minimal in-house token issuer for early development —
// the contract's open decisions list names a real OIDC/OAuth provider as
// something to confirm before production; swap this out then, the token
// shape (sub, tenantId, scopes) is designed to make that swap mechanical.
model ApiCredential {
  id               String   @id @default(cuid())
  tenantId         String
  clientId         String   @unique
  clientSecretHash String
  scopes           String[] // e.g. ["mobile.integration.read", "mobile.integration.write"]
  createdAt        DateTime @default(now())
  revokedAt        DateTime?

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@map("api_credentials")
}

enum InvoiceStatus {
  OPEN
  PARTIALLY_PAID
  PAID
  CANCELLED
}

enum MobileDeliveryStatus {
  QUEUED
  DELIVERED
  NOT_LINKED
  FAILED
}

model Invoice {
  id                  String                @id @default(cuid())
  tenantId            String
  providerInvoiceRef  String
  facilityRef         String
  patientRef          String
  description         String
  amountMinor         BigInt
  currency            String                @default("NGN")
  paidAmountMinor     BigInt                @default(0)
  status              InvoiceStatus         @default(OPEN)
  mobileDeliveryStatus MobileDeliveryStatus @default(QUEUED)
  dueAt               DateTime?
  metadata            Json?
  // Set when the invoice is billed to a company on account instead of the patient.
  corporateAccountId  String?
  // Unguessable token in the invoice's payment link. Anyone holding the link can pay this invoice.
  payToken            String?               @unique
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt

  tenant           Tenant                 @relation(fields: [tenantId], references: [id])
  fundingRequests  FamilyFundingRequest[]
  consents         FinancialConsent[]
  payments         Payment[]
  claims           Claim[]
  refunds          Refund[]
  paymentPlans     PaymentPlan[]
  financingRecords FinancingRecord[]
  corporateAccount CorporateAccount? @relation(fields: [corporateAccountId], references: [id])
  lines            InvoiceLine[]

  // Idempotent publish: same tenant + same provider-issued invoice ref must
  // resolve to one row, independent of the Idempotency-Key mechanism (which
  // guards the HTTP write itself). Belt and suspenders for a ledger.
  @@unique([tenantId, providerInvoiceRef])
  @@index([tenantId, facilityRef])
  @@index([tenantId, corporateAccountId])
  @@map("invoices")
}

enum FundingRequestStatus {
  OPEN
  PARTIALLY_FUNDED
  FUNDED
  CANCELLED
  EXPIRED
}

model FamilyFundingRequest {
  id                 String               @id @default(cuid())
  tenantId           String
  providerRequestRef String
  invoiceId          String
  patientRef         String
  facilityRef        String
  currency           String               @default("NGN")
  status             FundingRequestStatus @default(OPEN)
  fundedAmountMinor  BigInt               @default(0)
  expiresAt          DateTime?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  tenant        Tenant                  @relation(fields: [tenantId], references: [id])
  invoice       Invoice                 @relation(fields: [invoiceId], references: [id])
  contributions FundingContribution[]

  @@unique([tenantId, providerRequestRef])
  @@map("family_funding_requests")
}

enum ContributionStatus {
  PENDING
  PAID
  FAILED
}

model FundingContribution {
  id           String              @id @default(cuid())
  requestId    String
  sponsorRef   String
  amountMinor  BigInt
  status       ContributionStatus  @default(PENDING)
  paidAt       DateTime?
  createdAt    DateTime            @default(now())

  request FamilyFundingRequest @relation(fields: [requestId], references: [id])

  @@map("funding_contributions")
}

enum EligibilityStatus {
  PENDING
  COMPLETE
}

enum EligibilityDecision {
  ELIGIBLE
  PARTIALLY_ELIGIBLE
  INELIGIBLE
  PENDING
}

model EligibilityCheck {
  id                        String              @id @default(cuid())
  tenantId                  String
  providerRequestRef        String
  facilityRef               String
  patientRef                String
  payerRef                  String
  serviceCodes               String[]
  requestedAt                DateTime
  amountMinor                 BigInt?
  currency                    String?
  status                      EligibilityStatus   @default(PENDING)
  decision                    EligibilityDecision @default(PENDING)
  reasonCode                  String?
  coveredAmountMinor           BigInt?
  patientResponsibilityMinor   BigInt?
  validUntil                   DateTime?
  checkedAt                    DateTime?
  createdAt                    DateTime            @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, providerRequestRef])
  @@map("eligibility_checks")
}

enum ConsentStatus {
  RECORDED
  REVOKED
}

enum PayerType {
  PATIENT
  HMO
  INSURANCE
  FAMILY
  FINANCING
  CORPORATE
}

model FinancialConsent {
  id                 String        @id @default(cuid())
  tenantId           String
  providerConsentRef String
  facilityRef        String
  patientRef         String
  invoiceId          String
  estimateRevision   String
  policyVersion      String
  acceptedAt         DateTime
  actorRef           String?
  status             ConsentStatus @default(RECORDED)
  recordedAt         DateTime      @default(now())
  revokedAt          DateTime?

  tenant     Tenant                @relation(fields: [tenantId], references: [id])
  invoice    Invoice               @relation(fields: [invoiceId], references: [id])
  payerSplit ConsentPayerSplit[]

  @@unique([tenantId, providerConsentRef])
  @@map("financial_consents")
}

model ConsentPayerSplit {
  id          String    @id @default(cuid())
  consentId   String
  payerType   PayerType
  payerRef    String?
  amountMinor BigInt
  currency    String    @default("NGN")

  consent FinancialConsent @relation(fields: [consentId], references: [id])

  @@map("consent_payer_splits")
}

enum PaymentStatus {
  SUCCESS
  FAILED
  PENDING
}

// One row per payment collection event against an invoice (a card charge, a
// bank transfer, cash at the desk, an HMO remittance, ...). Distinct from
// Invoice.paidAmountMinor, which is the running total this feeds into — the
// invoice alone can't answer "what were the individual transactions."
// patientRef/facilityRef are the same opaque references as elsewhere in this
// schema; no PII is stored here either.
enum PaystackChargeStatus {
  PENDING
  SUCCESS
  FAILED
}

// One Paystack checkout started for an invoice. The webhook looks the charge
// up by `reference`, checks the amount against what was asked for, and only
// then records a Payment. `status` flips PENDING -> SUCCESS exactly once, so
// a redelivered webhook cannot record the money twice.
model PaystackCharge {
  id               String               @id @default(cuid())
  tenantId         String
  invoiceId        String
  reference        String               @unique
  amountMinor      BigInt
  email            String
  status           PaystackChargeStatus @default(PENDING)
  authorizationUrl String?
  paymentId        String?
  failureReason    String?
  // Set when a sponsor is paying a family funding pledge through this charge.
  fundingContributionId String?
  createdBy        String? // staff actor, as resolved from the token
  // Who started it: PROVIDER (staff), PATIENT (signed-in patient) or GUEST (payment link).
  source           String               @default("PROVIDER")
  // Set when a signed-in patient paid, or later claimed a guest payment.
  payerPatientRef  String?
  payerPhone       String?
  // Shown once on a guest receipt. A patient enters it to add the payment to their profile.
  claimCode        String?              @unique
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  @@index([tenantId, invoiceId])
  @@index([tenantId, payerPatientRef])
  @@map("paystack_charges")
}

model Payment {
  id                 String        @id @default(cuid())
  tenantId           String
  providerPaymentRef String
  invoiceId          String
  patientRef         String
  facilityRef        String
  channel            String // e.g. "card", "bank_transfer", "ussd", "cash", "hmo_direct"
  reference          String? // processor/channel reference (e.g. a Paystack transaction id)
  amountMinor        BigInt
  currency           String        @default("NGN")
  status             PaymentStatus @default(SUCCESS)
  occurredAt         DateTime      @default(now())
  createdAt          DateTime      @default(now())
  settlementId       String? // set once this payment is claimed into a settlement batch

  tenant     Tenant      @relation(fields: [tenantId], references: [id])
  invoice    Invoice     @relation(fields: [invoiceId], references: [id])
  refunds    Refund[]
  unmatchedTransactions UnmatchedTransaction[]
  paidInstallments PaymentPlanInstallment[]
  settlement Settlement? @relation(fields: [settlementId], references: [id])
  financingRecord FinancingRecord?

  @@unique([tenantId, providerPaymentRef])
  @@index([tenantId, facilityRef])
  @@index([tenantId, patientRef])
  @@index([tenantId, invoiceId])
  @@map("payments")
}

enum RefundStatus {
  PENDING
  APPROVED
  REJECTED
}

enum RefundRecoveryStatus {
  OWED
  RECOVERED
  WAIVED
}

// A request to reverse some or all of an existing Payment. The payment row
// itself is never edited or deleted — approving a refund instead reverses
// its effect on the invoice (paidAmountMinor decreases, status recomputes),
// same way a real accounting ledger keeps the original entry and posts a
// reversing one rather than mutating history.
model Refund {
  id                String       @id @default(cuid())
  tenantId          String
  providerRefundRef String
  paymentId         String
  invoiceId         String
  amountMinor       BigInt
  currency          String       @default("NGN")
  reason            String
  requestedBy       String
  status            RefundStatus @default(PENDING)
  decidedBy         String?
  decidedAt         DateTime?
  // Set only when the money went back through Paystack.
  gatewayRefundRef  String?
  gatewayStatus     String?
  // Set when the platform paid this refund out of its own Paystack balance for
  // a payment that settled to the provider's subaccount. The provider owes the
  // platform that amount until it is recovered or waived.
  recoveryStatus    RefundRecoveryStatus?
  recoveredAt       DateTime?
  recoveryNote      String?
  createdAt         DateTime     @default(now())

  tenant  Tenant  @relation(fields: [tenantId], references: [id])
  payment Payment @relation(fields: [paymentId], references: [id])
  invoice Invoice @relation(fields: [invoiceId], references: [id])

  @@unique([tenantId, providerRefundRef])
  @@index([tenantId, paymentId])
  @@index([tenantId, status])
  @@map("refunds")
}

enum ClaimStatus {
  DRAFT
  SUBMITTED
  APPROVED
  PARTIALLY_APPROVED
  REJECTED
}

// One row per HMO/insurer claim filed against an invoice. A claim is
// distinct from a Payment: filing one doesn't move money by itself — an
// APPROVED or PARTIALLY_APPROVED claim is what a payment (channel
// "hmo_direct") later settles against. patientRef/facilityRef/payerRef are
// the same opaque references as elsewhere in this schema; no PII here.
model Claim {
  id                  String      @id @default(cuid())
  tenantId            String
  providerClaimRef    String
  invoiceId           String
  patientRef          String
  facilityRef         String
  payerRef            String // the HMO/insurer this claim was filed against
  amountMinor         BigInt // amount claimed
  approvedAmountMinor BigInt?
  currency            String      @default("NGN")
  status              ClaimStatus @default(DRAFT)
  reason              String? // set when status is REJECTED
  submittedAt         DateTime?
  decidedAt           DateTime?
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  tenant  Tenant  @relation(fields: [tenantId], references: [id])
  invoice Invoice @relation(fields: [invoiceId], references: [id])

  @@unique([tenantId, providerClaimRef])
  @@index([tenantId, facilityRef])
  @@index([tenantId, patientRef])
  @@index([tenantId, invoiceId])
  @@map("claims")
}

// Enforces the Idempotency-Key contract: same key + same body -> replay the
// stored response. Same key + different body -> 409 Conflict. Keys are
// scoped per tenant and per route so two tenants (or two endpoints) can't
// collide.
model IdempotencyRecord {
  id             String   @id @default(cuid())
  tenantId       String
  key            String
  route          String
  requestHash    String
  responseStatus Int
  responseBody   Json
  createdAt      DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, route, key])
  @@map("idempotency_records")
}

// Where a tenant's provider backend receives ProviderEvent webhooks.
model WebhookEndpoint {
  id        String   @id @default(cuid())
  tenantId  String
  url       String
  secret    String   // used as the HMAC-SHA256 signing key; store via KMS/secret manager in production, not a plain column
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@map("webhook_endpoints")
}

enum OutboxStatus {
  PENDING
  DELIVERED
  DEAD_LETTERED
}

// Transactional outbox: every ProviderEvent is written here in the same
// transaction as the state change that caused it, then a separate worker
// delivers it with HMAC signing and bounded retry. This is what makes
// "payment state is authoritative only after a verified processor callback"
// (from the contract) survive a crash between "state changed" and "webhook sent".
model OutboxEvent {
  id            String       @id @default(cuid())
  tenantId      String
  eventId       String       @unique @default(cuid())
  eventType     String
  resourceRef   String
  occurredAt    DateTime     @default(now())
  data          Json
  status        OutboxStatus @default(PENDING)
  attempts      Int          @default(0)
  nextAttemptAt DateTime     @default(now())
  lastError     String?
  deliveredAt   DateTime?

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([status, nextAttemptAt])
  @@map("outbox_events")
}

enum UnmatchedTransactionStatus {
  UNMATCHED
  MATCHED
  EXCEPTION
}

// An inbound transfer/settlement the gateway or bank reported without a
// providerPaymentRef we can tie to an invoice on our own — e.g. a bank
// transfer that arrived with no (or an unreadable) reference. It sits here
// until someone on the reconciliation desk either matches it to a real
// invoice (which creates an ordinary Payment row and moves the invoice's
// balance, exactly like any other payment) or flags it as an exception for
// manual chase. This is never itself money moving — only the resulting
// Payment is.
model UnmatchedTransaction {
  id               String                     @id @default(cuid())
  tenantId         String
  source           String // e.g. "bank_transfer", "pos", "gateway"
  reference        String? // raw bank/gateway reference text, if any
  amountMinor      BigInt
  currency         String                     @default("NGN")
  receivedAt       DateTime                   @default(now())
  status           UnmatchedTransactionStatus @default(UNMATCHED)
  matchedPaymentId String?
  note             String? // set when flagged as an EXCEPTION
  createdAt        DateTime                   @default(now())

  tenant         Tenant   @relation(fields: [tenantId], references: [id])
  matchedPayment Payment? @relation(fields: [matchedPaymentId], references: [id])

  @@index([tenantId, status])
  @@map("unmatched_transactions")
}

enum StaffStatus {
  ACTIVE
  DEACTIVATED
}

// A roster entry for a person on the provider's staff — who they are, what
// role they were invited under, and which branch they're scoped to. This is
// a directory record, not an account: there is no per-staff login or
// session here (the whole provider backend authenticates as one shared
// OAuth client — see ApiCredential), so `role` is not enforced against any
// endpoint. It exists so a real invite/deactivate action has somewhere real
// to land, the same way UnmatchedTransaction exists so a real reconciliation
// decision has somewhere real to land.
enum StaffAccessLevel {
  ADMIN
  FINANCE
  BILLING
  CASHIER
  VIEWER
}

model Staff {
  id         String      @id @default(cuid())
  tenantId   String
  name       String
  email      String
  role       String // free-text job title, e.g. "Finance Manager". Display only; permissions come from accessLevel.
  // What this person may do. Existing rows default to ADMIN so nobody loses
  // access when this ships; new invites are created as CASHIER. See src/lib/permissions.ts.
  accessLevel StaffAccessLevel @default(ADMIN)
  branch     String? // free text branch/location label, opaque to this service
  status     StaffStatus @default(ACTIVE)
  invitedAt  DateTime    @default(now())
  deactivatedAt DateTime?
  // Null until a manager sets it (PATCH .../password). A staff member with
  // no password set yet cannot log in via POST /staff/login. Email is
  // unique platform-wide (not just per tenant) because login has no other
  // way to know which tenant a caller belongs to before verifying who they
  // are — a real limitation worth revisiting if this ever serves more than
  // one facility group under one login surface.
  passwordHash String?
  // Failed sign-ins since the last success, and when a lockout ends. See src/lib/lockout.ts.
  failedLoginCount Int       @default(0)
  lockedUntil      DateTime?

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([email])
  @@index([tenantId, status])
  @@map("staff")
}

enum PaymentPlanStatus {
  ACTIVE
  COMPLETED
}

enum PaymentPlanInstallmentStatus {
  PENDING
  PAID
}

// Splits an invoice's remaining balance (amountMinor - paidAmountMinor at
// creation time) into equal monthly installments. The only invented rules
// here are the ones a real implementation would still need product input
// on: even split (remainder folded into the last installment so the total
// is always exact), monthly-only cadence, no interest, no automatic
// "missed" penalty — a plan just tracks PENDING vs PAID per installment;
// whether an installment is overdue is a client-side read of dueAt vs now,
// not a stored judgment.
model PaymentPlan {
  id            String            @id @default(cuid())
  tenantId      String
  invoiceId     String
  totalMinor    BigInt
  installmentCount Int
  status        PaymentPlanStatus @default(ACTIVE)
  createdAt     DateTime          @default(now())

  tenant       Tenant                    @relation(fields: [tenantId], references: [id])
  invoice      Invoice                   @relation(fields: [invoiceId], references: [id])
  installments PaymentPlanInstallment[]

  @@index([tenantId, status])
  @@map("payment_plans")
}

model PaymentPlanInstallment {
  id            String                       @id @default(cuid())
  planId        String
  seq           Int // 1-based position in the schedule
  dueAt         DateTime
  amountMinor   BigInt
  status        PaymentPlanInstallmentStatus @default(PENDING)
  paidPaymentId String?
  paidAt        DateTime?

  plan        PaymentPlan @relation(fields: [planId], references: [id])
  paidPayment Payment?    @relation(fields: [paidPaymentId], references: [id])

  @@unique([planId, seq])
  @@map("payment_plan_installments")
}

enum SettlementStatus {
  PENDING
  SETTLED
}

// There's no real payment-gateway integration behind this service — Payment
// rows are written directly by whoever calls POST /provider/payments, not
// by a Paystack/Flutterwave webhook — so there's no real "payout" to track.
// What IS real and worth tracking: batching a facility's successful,
// not-yet-settled payments into one settlement run, the same way a finance
// team closes out a day's takings before it hits the bank. Creating a
// settlement claims every eligible Payment at that facility (via
// Payment.settlementId) so it can't be double-counted into a later batch.
// "SETTLED" here means "confirmed received," recorded by a human — it is
// not a real bank/processor payout confirmation.
model Settlement {
  id          String           @id @default(cuid())
  tenantId    String
  facilityRef String
  amountMinor BigInt
  status      SettlementStatus @default(PENDING)
  createdAt   DateTime         @default(now())
  settledAt   DateTime?

  tenant   Tenant    @relation(fields: [tenantId], references: [id])
  payments Payment[]

  @@index([tenantId, facilityRef, status])
  @@map("settlements")
}

// There's no real lender integration behind this — no CareCred/HealthPay/
// Sycamore API, no credit check, no disbursement webhook. What this records
// is a fact the facility itself enters: a named lender paid the facility's
// outstanding balance on an invoice upfront, so the invoice is settled from
// the facility's side immediately (via a real Payment on the "financing"
// channel) while the patient repays that lender separately, outside this
// system entirely. termMonths is purely a facility-entered label for what
// was agreed with the lender — it isn't tracked or enforced here.
model FinancingRecord {
  id          String   @id @default(cuid())
  tenantId    String
  invoiceId   String
  paymentId   String   @unique
  lenderName  String
  termMonths  Int?
  amountMinor BigInt
  createdAt   DateTime @default(now())

  tenant  Tenant  @relation(fields: [tenantId], references: [id])
  invoice Invoice @relation(fields: [invoiceId], references: [id])
  payment Payment @relation(fields: [paymentId], references: [id])

  @@index([tenantId, invoiceId])
  @@map("financing_records")
}

enum PartnerType {
  LABORATORY
  PHARMACY
  IMAGING
  SPECIALIST
  OTHER
}

enum PartnerStatus {
  ACTIVE
  INACTIVE
}

// A directory of outside labs/pharmacies/diagnostic centres a facility
// refers patients to. No routing logic and no billing integration — this is
// a record of who the partner is and a log of referrals sent to them,
// nothing more.
model Partner {
  id        String        @id @default(cuid())
  tenantId  String
  name      String
  type      PartnerType
  status    PartnerStatus @default(ACTIVE)
  createdAt DateTime      @default(now())

  tenant    Tenant     @relation(fields: [tenantId], references: [id])
  referrals Referral[]

  @@index([tenantId, status])
  @@map("partners")
}

enum ReferralStatus {
  SENT
  COMPLETED
}

model Referral {
  id           String         @id @default(cuid())
  tenantId     String
  partnerId    String
  facilityRef  String
  patientRef   String
  description  String
  status       ReferralStatus @default(SENT)
  createdAt    DateTime       @default(now())
  completedAt  DateTime?

  tenant  Tenant  @relation(fields: [tenantId], references: [id])
  partner Partner @relation(fields: [partnerId], references: [id])

  @@index([tenantId, status])
  @@map("referrals")
}

// Links a Clerk-authenticated identity (from the separate Patient MobileApp)
// to one opaque patientRef within one tenant. Distinct from the ad-hoc
// "patient" list GET /provider/patients derives from Invoice.patientRef
// groupings, which is a read-only aggregate for staff — this is a real
// account row that grants a specific phone/person read (and limited write)
// access to that patientRef's own records, via POST /patient/link and
// POST /patient/token (src/routes/patientAuth.ts).
//
// clerkUserId is globally unique (not scoped per tenant) — same tradeoff
// made for Staff.email: Clerk-token verification alone has no other signal
// to resolve which tenant a caller belongs to before an account exists.
// Worth revisiting if a patient could legitimately hold records at more
// than one tenant under one Clerk identity.
model PatientAccount {
  id          String   @id @default(cuid())
  tenantId    String
  patientRef  String
  clerkUserId String   @unique
  linkedAt    DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId, patientRef])
  @@map("patient_accounts")
}

enum HmoPolicyStatus {
  ACTIVE
  PENDING
  EXPIRED
}

// A patient's HMO/insurance policy card: the plan they're enrolled on, its
// annual benefit limit, co-pay percentage, and how much of that limit has
// been used so far. Replaces the mobile app's hardcoded "Demo health
// insurance" cards (HmoScreen) with real per-patient data.
//
// usedAmountMinor is a running total updated by whoever adjudicates a claim
// against this policy (see Claim) — nothing here recomputes it
// automatically yet; that write-back is a follow-up once claims settlement
// is wired to debit the matching policy.
model HmoPolicy {
  id               String          @id @default(cuid())
  tenantId         String
  patientRef       String
  provider         String
  policyNo         String
  enrolleeName     String
  planTier         String
  coPayPercent     Int
  annualLimitMinor BigInt
  usedAmountMinor  BigInt          @default(0)
  currency         String          @default("NGN")
  status           HmoPolicyStatus @default(ACTIVE)
  expiryDate       DateTime?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  tenant            Tenant             @relation(fields: [tenantId], references: [id])
  preAuthorizations PreAuthorization[]

  @@unique([tenantId, patientRef, policyNo])
  @@index([tenantId, patientRef])
  @@map("hmo_policies")
}

enum PreAuthStatus {
  APPROVED
  IN_REVIEW
  DECLINED
}

// A patient's request to pre-authorize a planned procedure against one of
// their HMO policies. Same "no real payer adapter yet" situation as
// EligibilityCheck (see eligibility.ts's simulateEligibilityDecision):
// every request is resolved instantly, APPROVED, splitting
// estimatedCostMinor by the policy's own coPayPercent — nothing here
// calls out to a real HMO. Swap the resolution step for a real payer
// call once one exists; the model and routes don't need to change.
model PreAuthorization {
  id                  String        @id @default(cuid())
  tenantId            String
  patientRef          String
  hmoPolicyId         String
  facilityRef         String
  procedure           String
  estimatedCostMinor  BigInt
  coveredAmountMinor  BigInt
  patientPortionMinor BigInt
  currency            String        @default("NGN")
  status              PreAuthStatus @default(APPROVED)
  approvalCode        String?
  notes               String?
  requestedAt         DateTime      @default(now())
  createdAt           DateTime      @default(now())

  tenant    Tenant    @relation(fields: [tenantId], references: [id])
  hmoPolicy HmoPolicy @relation(fields: [hmoPolicyId], references: [id])

  @@index([tenantId, patientRef])
  @@map("pre_authorizations")
}


// A provider's request to join. It is not a tenant. A person at Wellinovate
// reviews it and approves it with `npm run provider:approve`, which creates
// the tenant, its Paystack subaccount and the first Admin sign-in.
model ProviderApplication {
  id            String                    @id @default(cuid())
  businessName  String
  providerType  ProviderType
  contactName   String
  contactEmail  String
  contactPhone  String
  address       String?
  licenseNumber String?
  bankCode      String
  bankName      String?
  accountNumber String
  // Name the bank returned for the account number. The reviewer compares it
  // with the business name before approving.
  accountName   String
  status        ProviderApplicationStatus @default(PENDING)
  rejectionReason String?
  tenantId      String?
  createdAt     DateTime                  @default(now())
  reviewedAt    DateTime?

  @@index([status, createdAt])
  @@map("provider_applications")
}

// A patient the provider has registered. Invoices refer to a patient by
// patientRef, a free-text string; this table gives that reference a name and a
// phone number so the console can list the provider's own patients.
model PatientRecord {
  id          String   @id @default(cuid())
  tenantId    String
  patientRef  String
  fullName    String
  phone       String?
  email       String?
  facilityRef String?
  createdBy   String?
  createdAt   DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, patientRef])
  @@index([tenantId, createdAt])
  @@map("patient_records")
}

// A provider's saved price list. Invoices copy the name and price at the
// time they are made, so editing an item never changes an old invoice.
model ServiceItem {
  id             String   @id @default(cuid())
  tenantId       String
  name           String
  category       String?
  unitPriceMinor Int
  active         Boolean  @default(true)
  // Set for a package or panel: the ids of the items it contains. Empty for a single item.
  componentIds   String[] @default([])
  // Service record fields. `masterCode` links the item to the master diagnostic
  // catalogue (for example LAB-HAEM-001). `serviceCode` is the provider's own code.
  serviceCode    String?
  masterCode     String?
  sampleType     String?
  turnaround     String?
  preparation    String?
  homeCollection Boolean  @default(false)
  digitalResults Boolean  @default(false)
  createdBy      String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, name])
  @@unique([tenantId, masterCode])
  @@index([tenantId, active])
  @@map("service_items")
}

enum CheckupTier {
  CLASSIC
  EXECUTIVE
  DIAMOND
  PLATINUM
}

enum CheckupAudience {
  ALL
  MALE
  FEMALE
}

// An optional check-up package. It lists price-list items and does not
// replace them. The master test catalogue stays separate.
model CheckupPackage {
  id          String          @id @default(cuid())
  tenantId    String
  name        String
  tier        CheckupTier
  audience    CheckupAudience @default(ALL)
  priceMinor  Int
  includedIds String[]        @default([])
  exclusions  String?
  available   Boolean         @default(true)
  createdBy   String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, name])
  @@index([tenantId, available])
  @@map("checkup_packages")
}

enum BookingType {
  CENTRE_VISIT
  HOME_COLLECTION
}

// LAB is a sample test. IMAGING is a scan, which ends in a report instead of a result.
enum BookingKind {
  LAB
  IMAGING
}

enum BookingStatus {
  BOOKED
  SAMPLE_COLLECTED
  PROCESSING
  READY
  CANCELLED
}

// A sample collection or visit booked for a patient.
// One line on an invoice: a test or service with its own quantity and price.
// An invoice may have none (older invoices); then the description and total stand alone.
model InvoiceLine {
  id             String   @id @default(cuid())
  tenantId       String
  invoiceId      String
  position       Int
  description    String
  quantity       Int      @default(1)
  unitPriceMinor Int
  serviceItemId  String?
  createdAt      DateTime @default(now())

  tenant  Tenant  @relation(fields: [tenantId], references: [id])
  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId, position])
  @@map("invoice_lines")
}

enum ResultStatus {
  PENDING
  READY
}

// The result of one test (or the report of one scan) on a booking.
model BookingResult {
  id            String       @id @default(cuid())
  tenantId      String
  bookingId     String
  testName      String
  serviceItemId String?
  status        ResultStatus @default(PENDING)
  resultText    String?
  abnormal      Boolean      @default(false)
  enteredBy     String?
  enteredAt     DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  tenant  Tenant  @relation(fields: [tenantId], references: [id])
  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@unique([bookingId, testName])
  @@index([tenantId, bookingId])
  @@map("booking_results")
}

model Booking {
  id          String        @id @default(cuid())
  tenantId    String
  patientRef  String
  type        BookingType
  kind        BookingKind   @default(LAB)
  scheduledAt DateTime
  address     String?
  notes       String?
  status      BookingStatus @default(BOOKED)
  invoiceId   String?
  reminderSentAt DateTime?
  createdBy   String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  tenant  Tenant          @relation(fields: [tenantId], references: [id])
  results BookingResult[]

  @@index([tenantId, status, scheduledAt])
  @@map("bookings")
}

// A company the provider bills on account.
model CorporateAccount {
  id          String   @id @default(cuid())
  tenantId    String
  name        String
  contactName String?
  email       String?
  phone       String?
  active      Boolean  @default(true)
  createdBy   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant   Tenant    @relation(fields: [tenantId], references: [id])
  invoices Invoice[]

  @@unique([tenantId, name])
  @@map("corporate_accounts")
}
